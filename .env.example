# ==============================================================================
# SmartAttend Environment Variables Configuration
# Copy this file to .env and provide your values.
# ==============================================================================

# Supabase Project Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-Only Privileged Keys (Keep secret, never expose to client bundle)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Optional: Real Face Verification Provider Configuration
# Supported providers: 'rekognition' | 'faceplusplus' | 'azure_face' | 'workers_ai' | 'server_vision'
FACE_VERIFICATION_PROVIDER="server_vision"
FACE_VERIFICATION_API_KEY=""
FACE_VERIFICATION_API_URL=""
FACE_VERIFICATION_CONFIDENCE_THRESHOLD="75"

